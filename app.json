{
  "expo": {
    "name": "Turniq",
    "slug": "turniq",
    "version": "1.0.0",
    "orientation": "portrait",
    "primaryColor": "#0064E0",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#14161A"
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.hirolifecreative.turniq",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0064E0"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0392FF",
          "sounds": [
            "./assets/sounds/alarma_clasica.wav",
            "./assets/sounds/alarma_suave.wav",
            "./assets/sounds/alarma_fuerte.wav"
          ]
        }
      ],
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "54db937e-b6df-428a-89f2-252adaed0448"
      }
    },
    "owner": "nelsonherrera"
  }
}