{
  "expo": {
    "name": "Turniq",
    "slug": "turniq",
    "scheme": [
      "turniq",
      "com.hirolifecreative.turniq",
      "com.googleusercontent.apps.264084279710-ueg1mt9kk45fps701va58jc5n4edv1j6"
    ],
    "version": "1.1.10",
    "orientation": "portrait",
    "primaryColor": "#0064E0",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#14161A"
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.hirolifecreative.turniq",
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161A"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0392FF",
          "sounds": [
            "./assets/sounds/alarma_clasica.wav",
            "./assets/sounds/alarma_suave.wav",
            "./assets/sounds/alarma_fuerte.wav"
          ]
        }
      ],
      "expo-local-authentication",
      "expo-secure-store",
      "./plugins/withTurniqAlarm.js"
    ],
    "extra": {
      "eas": {
        "projectId": "54db937e-b6df-428a-89f2-252adaed0448"
      }
    },
    "owner": "nelsonherrera",
    "ios": {
      "bundleIdentifier": "com.hirolifecreative.turniq",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
